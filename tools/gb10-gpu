#!/bin/bash
# gb10-gpu — claim/release the Dell Pro Max GB10 for Grid Ops demos.
#
# This is now a THIN CLIENT of gridops-residency (10.0.13.200:8610). It used to
# drive the orchestrator and qsim directly, which meant two independent things
# could evacuate the machine at once — the shell script and the app — with no
# shared lock and two disagreeing ideas of what had been resident. There is one
# serialized path now, and this is its operator face.
#
# Why residency matters more here than on the L4 fleet: the GB10's 128 GiB is
# UNIFIED memory shared between CPU and GPU. Models managed by the vLLM
# orchestrator consume nearly the whole pool, which lowers the QUBIT CEILING,
# because the ceiling IS free memory. And an over-allocation does not just fail
# the run — on a unified pool it can evict the neighbour's model. Claim/release
# is correctness here, not etiquette.
#
# ⚠ A claim EVACUATES whatever the orchestrator has resident. LiteLLM stays up,
# but lanes backed by those GB10 processes cannot serve until release restores
# exactly the recorded set.
#
# Credentials: GRIDOPS_OPERATOR_TOKEN, from ~/.config/gridops/operator.env (600).
# Never passed on a command line — ps is world-readable.
set -euo pipefail

API="${GRIDOPS_RESIDENCY_URL:-http://10.0.13.200:8610}"
ENV_FILE="${GRIDOPS_OPERATOR_ENV:-$HOME/.config/gridops/operator.env}"
LEASE="${GRIDOPS_LEASE_SECONDS:-3600}"

[ -r "$ENV_FILE" ] && { set -a; . "$ENV_FILE"; set +a; }

if [ -z "${GRIDOPS_OPERATOR_TOKEN:-}" ]; then
  echo "ERROR — no GRIDOPS_OPERATOR_TOKEN (looked in $ENV_FILE)." >&2
  echo "        gridops-residency fails closed; it will refuse this call." >&2
  exit 2
fi

# --fail-with-body, not --fail: the service explains its refusals (409 with the
# in-flight operation, 403 with which check failed) and swallowing that body
# turns every diagnosable answer into "curl: (22)".
call() {
  local method="$1" path="$2" body="${3:-}"
  local args=(-sS --fail-with-body -m 1200 -X "$method" "$API$path"
              -H "Authorization: Bearer $GRIDOPS_OPERATOR_TOKEN"
              -H "X-Gridops-Auth-User: ${USER:-operator}")
  [ -n "$body" ] && args+=(-H 'Content-Type: application/json' -d "$body")
  curl "${args[@]}"
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
render() { python3 "$HERE/residency_render.py"; }

case "${1:-status}" in
  claim)
    echo "claiming the GB10 for Grid Ops via $API …"
    echo "  (this evacuates the orchestrator's resident models; their LiteLLM lanes"
    echo "   are unavailable until release restores exactly that set)"
    call POST /claim "{\"lease_seconds\":$LEASE,\"reason\":\"gb10-gpu claim\"}" | render ;;

  release)
    echo "releasing the GB10 via $API …"
    call POST /release '{"reason":"gb10-gpu release"}' | render ;;

  status)
    call GET /status | render ;;

  raw)
    call GET /status ;;

  *) echo "usage: gb10-gpu {claim|release|status|raw}" >&2; exit 2 ;;
esac
